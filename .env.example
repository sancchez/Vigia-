# Copia este archivo como .env y completa los valores reales. Nunca commitees .env.

# --- LLM (agents/_llm.py) ---
# Dos proveedores soportados: Anthropic (Claude) y OpenAI. Configura UNA de
# las dos keys de abajo -- VIGIA_LLM_PROVIDER es opcional, solo hace falta
# si tenés AMBAS keys y querés forzar cuál se usa (ver docs/despliegue.md).
ANTHROPIC_API_KEY=
# Si no hay ninguna key configurada, agents/_llm.py usa la CLI de Claude Code
# (claude -p) como fallback de desarrollo/demo -- SOLO funciona en una
# máquina con Claude Code instalado y con sesión iniciada, NUNCA en un host
# desplegado (Railway/Render). Timeout configurable, la latencia real varía:
VIGIA_CLAUDE_CLI_TIMEOUT=300

# Alternativa barata para producción real (no tiene fallback de CLI):
OPENAI_API_KEY=
# VIGIA_LLM_PROVIDER=openai
# VIGIA_OPENAI_MODEL=gpt-5.4-mini

# --- Base de datos ---
DATABASE_URL=sqlite:///./ciberseguridad.db
SUPABASE_URL=
SUPABASE_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth (multi-tenant, ver auth/jwt_auth.py) ---
# Genera uno real para cualquier entorno que no sea tu laptop de desarrollo:
# py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Pagos (Wompi, sandbox hasta tener una cuenta comercial real) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- Herramientas externas (se completan a medida que se integren en tools/) ---
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Escaneo recurrente (api/scheduler.py) ---
VIGIA_SCAN_INTERVAL_HOURS=6

# --- Vigilancia continua / CertStream (api/certstream_listener.py) ---
# El feed público histórico (wss://certstream.calidog.io) está muerto -- ver
# el docstring del propio listener. Fase 3c (deploy/certstream/docker-compose.yml)
# levanta un feed self-hosted con certstream-server-go; apuntá esta URL ahí
# (ver deploy/certstream/README.md para el paso a paso):
VIGIA_CERTSTREAM_URL=ws://localhost:8080/full-stream
# "false"/"0"/"no" para desactivar el listener por completo (degrada solo si
# el feed es inalcanzable, pero esto lo evita ni siquiera intentar conectar).
VIGIA_CERTSTREAM_ENABLED=true
# Minutos entre reconstrucciones del mapa de variantes de dominio/marca.
VIGIA_CERTSTREAM_REFRESH_MINUTES=30

# --- Notificaciones y alertas (api/notificaciones.py, Fase 5) ---
# Envío por email vía smtplib (stdlib, sin dependencias nuevas). Sin
# VIGIA_SMTP_HOST configurado, el envío se omite en silencio (no rompe nada
# -- ver api/notificaciones.py::_config_smtp). Canal 'email' es el único
# soportado en v1; Slack/webhook quedan como follow-up explícito.
VIGIA_SMTP_HOST=
VIGIA_SMTP_PORT=587
VIGIA_SMTP_USER=
VIGIA_SMTP_PASSWORD=
VIGIA_SMTP_FROM=
VIGIA_SMTP_TLS=true
# Cada cuántas horas se barre findings.sla_due_at para el aviso al 75% del
# plazo / al vencer (api/scheduler.py::run_sla_escalation_once):
VIGIA_SLA_CHECK_INTERVAL_HOURS=6

# --- Rate limiting de la API HTTP (api/main.py, slowapi) ---
# Los límites se cuentan por TENANT cuando el request trae un JWT válido, y
# por IP cuando no (ver api/main.py::clave_rate_limit). Formato de slowapi:
# "<n>/<unidad>" -- "10/hour", "5/minute", varios separados por ';'.
# "false"/"0"/"no" apaga el limitador por completo (la suite de tests lo
# apaga así, ver tests/conftest.py). Si el paquete `slowapi` no está
# instalado, la app arranca igual SIN límites y lo avisa en el log.
VIGIA_RATE_LIMIT_ENABLED=true
# Límite por defecto de TODOS los endpoints:
VIGIA_RATE_LIMIT_DEFAULT=120/minute
# Endpoints caros (arrancan herramientas externas o gastan tokens de LLM):
VIGIA_RATE_LIMIT_SCAN=10/hour
VIGIA_RATE_LIMIT_SCAN_ACTIVO=5/hour
VIGIA_RATE_LIMIT_ANTISUPLANTACION=10/hour
# /reports/revision-ia además cuesta dinero real en tokens:
VIGIA_RATE_LIMIT_REVISION_IA=5/hour

# --- Cortesía de red al sondear dominios lookalike (tools/antisuplantacion.py) ---
# `puntuar_infra_lookalike` y `capturar_screenshot` abren conexiones
# DNS/MX/TLS/HTTP (y cargan el sitio con Chromium headless) contra dominios
# de TERCEROS que nunca consintieron. Los defaults son deliberadamente
# conservadores: cortesía sobre velocidad. Subirlos es una decisión con
# consecuencias legales, no un ajuste de rendimiento.
# Espera mínima (segundos) entre sondeos consecutivos a hosts distintos:
VIGIA_SONDEO_DELAY_SEGUNDOS=2
# Espera mínima (segundos) entre dos sondeos al MISMO host:
VIGIA_SONDEO_DELAY_MISMO_HOST=10
# Tope de sondeos simultáneos en todo el proceso:
VIGIA_SONDEO_MAX_CONCURRENTE=2
# Identidad declarada del bot: debe decir quién es y a dónde escribir. Un bot
# identificable demuestra que no hay ocultamiento -- es defensa legal real.
# La URL apunta al repo público mientras no exista sitio institucional
# publicado; reemplázala por la URL definitiva antes de operar comercialmente.
VIGIA_BOT_USER_AGENT=Vigia-BrandMonitor/1.0 (+https://github.com/sancchez/Vigia-/blob/main/legal/politica-uso-aceptable.md)

# --- Escaneo activo ZAP: tope de concurrencia (tools/zap_api.py) ---
# Cada escaneo activo es un contenedor ZAP entero + tráfico de ataque real.
# Sin tope, N requests concurrentes levantan N oleadas en paralelo.
VIGIA_ZAP_MAX_CONCURRENTES=2
# Cuánto espera un escaneo por un cupo libre antes de fallar con un error
# explícito (segundos):
VIGIA_ZAP_ESPERA_SLOT_SEGUNDOS=600

# --- Retención de screenshots de terceros (api/scheduler.py) ---
# Dónde se guardan los PNG de los sitios clon capturados por
# POST /antisuplantacion:
VIGIA_SCREENSHOT_DIR=data/screenshots
# Días tras los cuales una captura se borra automáticamente. Guardar
# evidencia de una suplantación es legítimo; guardarla para siempre no lo es.
VIGIA_SCREENSHOT_RETENCION_DIAS=90
# Cada cuántas horas corre la purga (api/scheduler.py::run_screenshot_purge_once):
VIGIA_SCREENSHOT_PURGE_INTERVAL_HOURS=24
